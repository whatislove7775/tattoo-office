NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# If empty, local development uses embedded PostgreSQL (PGlite).
DATABASE_URL=
DATA_DIR=./work/database
# Set before first startup. No bundled administrator password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDKASSIR_API_SECRET=
TELEGRAM_BOT_TOKEN=
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_CALENDAR_SYNC_ENABLED=false
EMAIL_API_URL=
EMAIL_API_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
CLOUDKASSIR_PUBLIC_ID=
POSTGRES_PASSWORD=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Beget SMTP: mailbox credentials, not the server root password.
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
